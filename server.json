{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.thestockgoatballs/clipspeed-mcp",
  "description": "AI video, images, AI influencers, character swaps and clipping from Claude or ChatGPT.",
  "version": "1.0.3",
  "repository": {
    "url": "https://github.com/thestockgoatballs/clipspeed-mcp",
    "source": "github"
  },
  "websiteUrl": "https://www.clipspeed.ai/mcp/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.clipspeed.ai/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clipspeed-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLIPSPEED_API_KEY",
          "description": "Your ClipSpeed API key (csai_live_...), from https://www.clipspeed.ai/dashboard/api-key/",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CLIPSPEED_BASE_URL",
          "description": "API base URL. Defaults to https://api.clipspeed.ai",
          "isRequired": false,
          "default": "https://api.clipspeed.ai"
        }
      ]
    }
  ]
}
